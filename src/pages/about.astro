---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactOptions from '../components/ContactOptions.astro';
import { aboutPageSchema } from '../utils/schema';

const description =
  'About CommsDock: a solo voice telecom engineering practice combining PBX, contact centre, cloud, network infrastructure, software, and voice AI delivery.';
---

<BaseLayout title="About" description={description} schema={[aboutPageSchema('/about', 'About CommsDock', description)]}>
  <PageIntro
    label="About"
    title="One engineer across the voice estate, the infrastructure, and the code."
    summary="CommsDock is built around a simple operating model: the person who scopes the voice problem is the person who owns delivery."
  />
  <section class="container about-body">
    <div>
      <h2>Voice telecom first</h2>
      <p>
        The practice starts from business voice systems: NEC PBX, Panasonic PBX, Avaya IP Office, Avaya Contact Center, Webex, BroadWorks call centre, 3CX, and Yeastar Cloud PBX.
      </p>
    </div>
    <div>
      <h2>Infrastructure aware</h2>
      <p>
        Voice work often depends on AWS instances, security groups, SES, static egress IPs, VLANs, Ubiquiti Wi-Fi, and router configuration across DrayTek, TP-Link, and similar SMB networks.
      </p>
    </div>
    <div>
      <h2>Software capable</h2>
      <p>
        When the problem needs tooling, integration, dashboards, APIs, or voice AI workflows, CommsDock can build the software instead of handing the context to another vendor.
      </p>
    </div>
    <div>
      <h2>Delivery oriented</h2>
      <p>
        The output is not abstract strategy. It is clearer call flows, buildable voice architecture, working software, and operational handover.
      </p>
    </div>
  </section>
  <ContactOptions />
</BaseLayout>

<style>
  .about-body {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding-bottom: 48px;
  }
  h2 {
    font-family: var(--font-display);
    font-size: 26px;
    margin-bottom: 12px;
  }
  p {
    color: var(--text-2);
    line-height: 1.65;
  }
  @media (max-width: 900px) {
    .about-body {
      grid-template-columns: 1fr;
    }
  }
</style>
