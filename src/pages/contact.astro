---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactOptions from '../components/ContactOptions.astro';
import { site } from '../content/site';
import { contactPageSchema } from '../utils/schema';

const description =
  'Contact CommsDock for voice telecom engineering, PBX and contact centre architecture, software integration, and voice AI engagements.';
---

<BaseLayout title="Contact" description={description} schema={[contactPageSchema('/contact', 'Contact CommsDock', description)]}>
  <PageIntro
    label="Contact"
    title="Bring the voice context. Leave with a clearer next move."
    summary={`Email ${site.email} with the platform, call-flow problem, constraints, and timeline. CommsDock responds within one business day.`}
  />
  <ContactOptions />
</BaseLayout>
