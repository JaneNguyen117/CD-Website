---
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { articleSchema, personSchema, professionalServiceSchema, websiteSchema } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown>[];
  frontmatter?: {
    title?: string;
    description?: string;
    pubDate?: string | Date;
  };
}

const {
  canonical,
  ogImage = '/og-default.svg',
  noIndex = false,
  schema = [],
  frontmatter = {},
} = Astro.props;

const siteName = 'CommsDock';
const title = Astro.props.title ?? frontmatter.title ?? siteName;
const description =
  Astro.props.description ??
  frontmatter.description ??
  'Voice telecom engineering practice for PBX, contact centre, collaboration platforms, and voice AI systems.';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://commsdock.com';
const fullTitle = title === siteName ? `${siteName} - Voice telecom engineering practice` : `${title} - ${siteName}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const noteArticleSchema =
  Astro.url.pathname.startsWith('/notes/') && frontmatter.title && frontmatter.description && frontmatter.pubDate
    ? [
        articleSchema({
          pathname: Astro.url.pathname,
          title: frontmatter.title,
          description: frontmatter.description,
          pubDate: frontmatter.pubDate,
        }),
      ]
    : [];
const allSchema = [websiteSchema(), personSchema(), professionalServiceSchema(), ...schema, ...noteArticleSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    {
      allSchema.map((schemaObject) => (
        <script type="application/ld+json" set:html={JSON.stringify(schemaObject)} is:inline />
      ))
    }

    <!-- Per-page head extras -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
